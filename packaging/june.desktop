[Desktop Entry]
Type=Application
Name=June
Comment=June
# No --daemon: a daemon is usually running already, started at login or by install.sh, and a second one exits with "port in use" the moment it cannot bind 6942, so clicking the icon would do nothing. Plain `june` reuses the running daemon and shows its window, and starts one first if none is up. install.sh rewrites this to the absolute path of the installed binary.
Exec=june
Icon=june
Terminal=false
StartupWMClass=june
Categories=Utility;
