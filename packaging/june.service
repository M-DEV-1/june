[Unit]
Description=June
# Bound to the graphical session, not to default.target: the user manager reaches default.target at login, before gnome-session has started graphical-session.target and imported DISPLAY, WAYLAND_DISPLAY and DBUS_SESSION_BUS_ADDRESS into the user manager's environment. Started there, the daemon has no display to open its window on and no session bus to put its tray on. WantedBy=graphical-session.target makes gnome-session start it once that environment exists, and PartOf stops it at logout.
PartOf=graphical-session.target
After=graphical-session.target

[Service]
ExecStart=%h/.local/bin/june --daemon
Restart=on-failure
EnvironmentFile=-%h/.config/june/env

[Install]
WantedBy=graphical-session.target
