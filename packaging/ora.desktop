[Desktop Entry]
Type=Application
Name=Ora
Comment=Ora
# No --daemon: install.sh has already started the daemon as a systemd user service, and a second one exits with "port in use" the moment it cannot bind 6942, so clicking the icon would do nothing. Plain `ora` reuses the running daemon and shows its window, and starts one first if none is up. install.sh rewrites this to the absolute path of the installed binary.
Exec=ora
Icon=ora
Terminal=false
StartupWMClass=ora
Categories=Utility;
