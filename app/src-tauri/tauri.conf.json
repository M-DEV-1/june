{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "June",
  "version": "0.2.0-rc.1",
  "identifier": "dev.june.app",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "June",
        "width": 720,
        "height": 520,
        "resizable": false,
        "decorations": false,
        "alwaysOnTop": false,
        "visible": false,
        "skipTaskbar": true,
        "transparent": true,
        "shadow": false
      },
      {
        "label": "app",
        "url": "next.html",
        "title": "June",
        "width": 1140,
        "height": 760,
        "resizable": true,
        "decorations": true,
        "visible": false,
        "center": true
      },
      {
        "label": "overlay",
        "url": "overlay.html",
        "title": "June",
        "width": 640,
        "height": 480,
        "x": 0,
        "y": 0,
        "resizable": true,
        "decorations": false,
        "alwaysOnTop": false,
        "visibleOnAllWorkspaces": true,
        "skipTaskbar": true,
        "focus": false,
        "focusable": false,
        "visible": false,
        "transparent": true,
        "shadow": false,
        "acceptFirstMouse": false
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' data:",
        "font-src": "'self' data:",
        "connect-src": "'self' ipc: http://ipc.localhost http://127.0.0.1:6942",
        "object-src": "'none'",
        "base-uri": "'self'"
      },
      "dangerousDisableAssetCspModification": ["style-src"]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}